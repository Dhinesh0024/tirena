---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <p class="logo">TIRENA</p>
      <p class="tagline">Personal care, clearly.</p>
    </div>
    <div class="footer-cols">
      <div>
        <h3>Explore</h3>
        <ul>
          <li><a href="/hair-care">Hair Care</a></li>
          <li><a href="/skin-care">Skin Care</a></li>
          <li><a href="/body-care">Body Care</a></li>
        </ul>
      </div>
      <div>
        <h3>Choose</h3>
        <ul>
          <li><a href="/reviews">Reviews</a></li>
          <li><a href="/comparisons">Comparisons</a></li>
        </ul>
      </div>
      <div>
        <h3>Site</h3>
        <ul>
          <li><a href="/about">About</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <p>&copy; {year} TIRENA. Some links on this site are affiliate links — if you buy through them, TIRENA may earn a commission at no extra cost to you.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: 60px;
    background: var(--surface);
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    padding: 56px 28px 40px;
    flex-wrap: wrap;
  }
  .footer-brand .logo {
    font-family: var(--serif);
    font-size: 1.3rem;
    margin: 0;
    color: var(--ink);
  }
  .footer-brand .tagline {
    color: var(--ink-soft);
    margin: 4px 0 0;
    font-size: 0.9rem;
  }
  .footer-cols {
    display: flex;
    gap: 56px;
  }
  .footer-cols h3 {
    font-family: var(--sans);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 12px;
  }
  .footer-cols ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .footer-cols a {
    text-decoration: none;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .footer-cols a:hover { color: var(--sage-deep); }
  .footer-bottom {
    border-top: 1px solid var(--line);
    padding: 18px 28px;
  }
  .footer-bottom p {
    font-size: 0.8rem;
    color: var(--ink-soft);
    margin: 0;
    max-width: none;
  }
  @media (max-width: 640px) {
    .footer-inner { flex-direction: column; }
    .footer-cols { gap: 32px; flex-wrap: wrap; }
  }
</style>
