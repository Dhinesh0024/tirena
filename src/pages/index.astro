---
import Base from '../layouts/Base.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const latest = allArticles
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 6);
---
<Base>
  <!-- HERO -->
  <section class="section hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <h1>The Definitive Word on Personal Care.</h1>
        <p class="lead">
          Curated intelligence for the discerning skin and hair enthusiast.
          Uncompromising. Authoritative. Definitive.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/hair-care">Discover the Ritual of Hair Care</a>
          <a class="btn btn-secondary" href="/skin-care">Experience the Art of Skin Care</a>
        </div>
      </div>
    </div>
  </section>

  <!-- EXPLORE PERSONAL CARE -->
  <section class="section">
    <div class="wrap">
      <span class="eyebrow-mark"></span>
      <h2>The TIRENA Curation</h2>
      <p>Curated intelligence to elevate your personal care ritual.</p>
      <div class="grid-3" style="margin-top: 40px;">
        <CategoryCard
          title="Hair Care"
          description="The science of scalp health, hair density, and high-performance routines."
          href="/hair-care"
        />
        <CategoryCard
          title="Skin Care"
          description="Advanced biological guidance for complexion clarity and timeless skin health."
          href="/skin-care"
        />
        <CategoryCard
          title="Body Care"
          description="The art of somatic body care, luxury fragrance, and systemic wellness."
          href="/body-care"
        />
      </div>
    </div>
  </section>

  <!-- START HERE -->
  <section class="section start-here">
    <div class="wrap">
      <div class="start-card">
        <span class="eyebrow-mark"></span>
        <h2>The Foundation</h2>
        <p>True beauty is built on knowledge. Master the fundamentals of personal care before investing in the products.</p>
        <p class="start-desc">
          Enter the world of TIRENA and learn the biological foundations of skincare and hair health.
        </p>
         <a class="btn btn-primary" href="/articles/2026-09-02-how-to-read-a-skincare-ingredient-label/">Access the Guide</a>
      </div>
    </div>
  </section>

  <!-- LATEST FROM TIRENA -->
  <section class="section">
    <div class="wrap">
      <span class="eyebrow-mark"></span>
      <h2>The Latest Intelligence</h2>
      <p>New dossiers, deep-dives, and authoritative comparisons.</p>
      {latest.length > 0 ? (
        <div class="grid-3" style="margin-top: 40px;">
          {latest.map((article) => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              href={`/articles/${article.slug}`}
              image={article.data.image}
              category={article.data.category.replace('-', ' ')}
            />
          ))}
        </div>
      ) : (
        <p class="empty-state">No articles published yet — the first ones will appear here automatically once you publish through the CMS.</p>
      )}
    </div>
  </section>

  <!-- MAKE A BETTER CHOICE -->
  <section class="section">
    <div class="wrap">
      <span class="eyebrow-mark"></span>
      <h2>The Comparison Lab</h2>
      <p>Where we strip away the marketing to reveal the biological truth.</p>
      <div class="grid-2" style="margin-top: 40px;">
        <div class="card">
          <h3>Dossiers</h3>
          <p>Uncompromising looks at products, ingredients, and actual efficacy.</p>
          <a class="btn btn-gold" href="/reviews">View Dossiers</a>
        </div>
        <div class="card">
          <h3>Benchmarks</h3>
          <p>Side-by-side biological breakdowns to help you choose with absolute certainty.</p>
          <a class="btn btn-gold" href="/comparisons">View Benchmarks</a>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY TIRENA -->
  <section class="section">
    <div class="wrap">
      <span class="eyebrow-mark"></span>
      <h2>The TIRENA Standard</h2>
      <p>We don't follow trends; we analyze the science behind them.</p>
      <div class="grid-3" style="margin-top: 40px;">
        <div>
          <h3>Uncompromising</h3>
          <p>We strip away the jargon and marketing hype to reveal the evidence.</p>
        </div>
        <div>
          <h3>Curated</h3>
          <p>We only recommend products that pass our rigorous biological audit.</p>
        </div>
        <div>
          <h3>Authoritative</h3>
          <p>The definitive source for those who demand the best for their skin and hair.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="section about-cta">
    <div class="wrap about-inner">
      <div>
        <h2>About TIRENA</h2>
        <p>
          TIRENA is a high-performance personal-care publication dedicated to the
          pursuit of biological excellence in skin, hair, and body care.
        </p>
      </div>
      <a class="btn btn-secondary" href="/about">The TIRENA Manifesto</a>
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: 120px; padding-bottom: 120px; }
  .hero-inner { max-width: 800px; }
  .hero-copy .lead { font-size: 1.3rem; max-width: 60ch; }
  .hero-actions { display: flex; gap: 16px; margin-top: 12px; flex-wrap: wrap; }

  .start-here .start-card {
    background: var(--surface);
    border: none;
    box-shadow: 0 10px 40px rgba(0,0,0,0.04);
    border-radius: var(--radius);
    padding: 60px;
    max-width: 800px;
  }
  .start-desc { font-size: 1.1rem; }

  .empty-state {
    margin-top: 32px;
    padding: 32px;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    font-size: 0.9rem;
    text-align: center;
  }

  .about-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
  }
  .about-inner > div { max-width: 600px; }

  @media (max-width: 640px) {
    .hero { padding-top: 80px; padding-bottom: 80px; }
    .start-here .start-card { padding: 40px; }
  }
</style>
