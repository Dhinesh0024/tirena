---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allArticles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---
<Base title="Shop" description="Every TIRENA guide in one place — search or scroll to find what you're looking for.">
  <section class="section shop-hero">
    <div class="wrap">
      <span class="eyebrow-mark"></span>
      <h1>Find what you're looking for</h1>
      <p>Search by product, ingredient, or concern — or just scroll.</p>
      <input
        type="text"
        id="search-input"
        placeholder="Try 'oily scalp', 'vitamin c', 'sunscreen'..."
        class="search-box"
        autocomplete="off"
      />
    </div>
  </section>

  <section class="section" style="border-top: none; padding-top: 0;">
    <div class="wrap">
      <div id="article-list" class="shop-list">
        {allArticles.map((article) => (
          
            href={`/articles/${article.slug}/`}
            class="shop-item"
            data-search={`${article.data.title} ${article.data.description} ${article.data.category}`.toLowerCase()}
          >
            <div class="shop-item-cat">{article.data.category.replace('-', ' ')}</div>
            <div class="shop-item-title">{article.data.title}</div>
            <div class="shop-item-desc">{article.data.description}</div>
          </a>
        ))}
      </div>
      <p id="no-results" class="no-results" style="display: none;">
        Nothing matched that search — try a different word, or browse the full list above.
      </p>
    </div>
  </section>
</Base>

<style>
  .shop-hero { padding-top: 56px; padding-bottom: 24px; }
  .shop-hero p { margin-bottom: 24px; }

  .search-box {
    width: 100%;
    max-width: 520px;
    padding: 16px 20px;
    font-size: 1rem;
    font-family: var(--sans);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
  }
  .search-box:focus {
    outline: none;
    border-color: var(--sage-deep);
  }

  .shop-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 720px;
  }

  .shop-item {
    display: block;
    text-decoration: none;
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: 3px solid var(--sage);
    border-radius: var(--radius);
    padding: 20px 24px;
    transition: border-color 0.15s ease, transform 0.1s ease;
  }
  .shop-item:hover {
    border-color: var(--sage-deep);
    border-left-color: var(--clay);
  }

  .shop-item-cat {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--sage-deep);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 6px;
  }
  .shop-item-title {
    font-family: var(--serif);
    font-size: 1.15rem;
    color: var(--ink);
    margin-bottom: 6px;
  }
  .shop-item-desc {
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin: 0;
    max-width: none;
  }

  .no-results {
    padding: 28px;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    font-size: 0.9rem;
    max-width: 720px;
  }
</style>

<script>
  const input = document.getElementById('search-input');
  const items = Array.from(document.querySelectorAll('.shop-item'));
  const noResults = document.getElementById('no-results');

  input?.addEventListener('input', () => {
    const query = (input as HTMLInputElement).value.trim().toLowerCase();
    let visibleCount = 0;
    items.forEach((item) => {
      const haystack = item.getAttribute('data-search') || '';
      const match = haystack.includes(query);
      (item as HTMLElement).style.display = match ? 'block' : 'none';
      if (match) visibleCount++;
    });
    if (noResults) {
      (noResults as HTMLElement).style.display = visibleCount === 0 ? 'block' : 'none';
    }
  });
</script>
